# Keep the build context small and free of local runtime state.
.git
.gitignore
.idea
.vscode

# Local build output and Go caches.
bin
output
temp
.cache-bin
.cache

# Runtime state: the SQLite database, the icon cache and the session files must
# never be baked into the image, they are created on first start.
resource/data
data
manifest/output

# Per-deployment settings. They are not part of the image and would otherwise
# invalidate the build cache on every local change.
.env
.env.local
