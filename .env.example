# ---------------------------------------------------------------------------
# xyhelper-nav — local deployment settings.
#
# Copy this file to ".env" and adjust what you need:
#
#   cp .env.example .env
#
# Docker Compose reads ".env" automatically and ".env" is git ignored, so your
# local values never conflict with "git pull".
# ---------------------------------------------------------------------------

# Host port the navigation page is published on.
# Example: NAV_PORT=18080
NAV_PORT=8000

# Address the port is bound to.
# Use 127.0.0.1 when the service sits behind a reverse proxy and should not be
# reachable directly from the internet.
NAV_BIND=0.0.0.0

# Host directory holding the SQLite database, the icon cache and the sessions.
NAV_DATA_DIR=./data

# Timezone used for log timestamps.
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# Optional overrides, uncomment when needed.
# ---------------------------------------------------------------------------

# Image tag built by "docker compose build".
#NAV_IMAGE=xyhelper/nav:latest

# Container name, change it to run more than one instance on a single host.
#NAV_CONTAINER_NAME=xyhelper-nav

# Restart policy: unless-stopped, always, on-failure or "no".
#NAV_RESTART=unless-stopped
